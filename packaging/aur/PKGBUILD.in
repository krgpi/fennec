# Maintainer: Karaage <karaage01@outlook.jp>
pkgname=fennec-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="会議の録音・文字起こし・議事録生成アプリ"
arch=('x86_64')
url="https://github.com/krgpi/fennec"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'librsvg' 'alsa-lib' 'pipewire')
provides=('fennec')
conflicts=('fennec')
options=('!strip' '!emptydirs')
source=("${url}/releases/download/v${pkgver}/Fennec_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf "${srcdir}"/data.tar.* -C "${pkgdir}"
}
